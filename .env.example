# AI-Powered Autonomous SOC Assistant Environment Configuration
# Copy this file to .env and set your values

# Google Gemini API Key for AI Security Analysis
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (e.g., gemini-flash-latest or gemini-2.5-flash)
GEMINI_MODEL=gemini-flash-latest

# SQLite Database path (defaults to data/soc_database.sqlite)
DATABASE_PATH=data/soc_database.sqlite

# Vector store index directory
VECTOR_STORE_DIR=knowledge_base/faiss_index

# Central Ingestion API Configuration
SOC_API_HOST=127.0.0.1
SOC_API_PORT=8000
SOC_AGENT_TOKEN=soc-secure-agent-token-2026

# Live Threat Detection Thresholds
LIVE_FAILED_LOGIN_HOST_THRESHOLD=5
LIVE_FAILED_LOGIN_USER_THRESHOLD=3
LIVE_PASSWORD_SPRAY_USER_THRESHOLD=3
LIVE_DETECTION_WINDOW_MINUTES=5

